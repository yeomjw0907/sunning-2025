{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300
    }
  },
  "ignoreCommand": "node -e \"process.exit(process.env.VERCEL_ENV==='production'?1:0)\"",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/sunning/drain",
      "schedule": "*/5 * * * *"
    }
  ]
}